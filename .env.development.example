# ── LLM Provider ──────────────────────────────────────────
# Choose one: claude | gemini | azure | groq
LLM_PROVIDER=gemini

# ── Claude ────────────────────────────────────────────────
# Required when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# ── Gemini ────────────────────────────────────────────────
# Required when LLM_PROVIDER=gemini
GOOGLE_API_KEY=

# ── Groq ──────────────────────────────────────────────────
# Required when LLM_PROVIDER=groq
GROQ_API_KEY=

# ── Azure OpenAI ──────────────────────────────────────────
# Required when LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Embedding deployment name (for eval ingestion only)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ── Memory Pipeline ───────────────────────────────────────
# Gemini model suggestion: gemini-2.0-flash
# Groq model suggestion:   llama-3.3-70b-versatile
# Claude model suggestion: claude-3-5-haiku-20241022
MEMORY_EXTRACTION_MODEL=gemini-2.0-flash
RECENCY_WINDOW=10
SIMILARITY_TOP_K=10

# ── Embeddings (Gemini — uses same GOOGLE_API_KEY) ────────
EMBEDDING_MODEL=gemini-embedding-exp-03-07
EMBEDDING_DIMENSION=768

# ── Qdrant ────────────────────────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=eidetic_memories

# ── API Server ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# ── Evaluation ────────────────────────────────────────────
# Used for eval runs only — not needed for normal operation
EVAL_LLM_JUDGE_MODEL=gemini-2.0-flash
