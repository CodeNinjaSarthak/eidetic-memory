# ── LLM Provider ──────────────────────────────────────────
# Choose one: claude | gemini | azure | groq | openai
LLM_PROVIDER=

# ── Claude ────────────────────────────────────────────────
# Required when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# ── Gemini ────────────────────────────────────────────────
# Required when LLM_PROVIDER=gemini
GOOGLE_API_KEY=

# ── Groq ──────────────────────────────────────────────────
# Required when LLM_PROVIDER=groq
GROQ_API_KEY=

# ── Azure OpenAI ──────────────────────────────────────────
# Option A: Azure OpenAI (LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_EMBEDDING_API_VERSION=2023-05-15

# Embedding deployment name (for eval ingestion only)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ── OpenAI ────────────────────────────────────────────────
# Option B: OpenAI directly (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Memory Pipeline ───────────────────────────────────────
# Gemini model suggestion: gemini-2.0-flash
# Groq model suggestion:   llama-3.3-70b-versatile
# Claude model suggestion: claude-3-5-haiku-20241022
MEMORY_EXTRACTION_MODEL=llama-3.3-70b-versatile
RECENCY_WINDOW=10
# Retrieval default only — the benchmark (eval_qa_accuracy.py) hardcodes
# --top-k=30 regardless of this value, so this "10" is not the paper's setting.
SIMILARITY_TOP_K=10

# ── Embeddings (decoupled from LLM_PROVIDER — see ARCHITECTURE.md #14) ────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ── Qdrant ────────────────────────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=eidetic_memories

# ── API Server ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# ── Evaluation ────────────────────────────────────────────
# Used for eval runs only — not needed for normal operation
EVAL_LLM_JUDGE_MODEL=
